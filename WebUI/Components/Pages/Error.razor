@page "/Error"
@using System.Diagnostics
@using Microsoft.AspNetCore.Diagnostics
@inject IWebHostEnvironment Environment
@inject ILogger<Error> Logger

<PageTitle>Error</PageTitle>

<div class="container mt-5">
    <h1 class="text-danger">Error.</h1>
    <h2 class="text-danger mb-4">An error occurred while processing your request.</h2>

    @if (ShowRequestId)
    {
        <p>
            <strong>Request ID:</strong> <code>@RequestId</code>
        </p>
    }

    @if (ErrorFeature is not null && Environment.IsDevelopment())
    {
        <div class="card mt-4 border-danger">
            <div class="card-header bg-danger text-white">
                <strong>Exception details (Development only)</strong>
            </div>
            <div class="card-body">
                <p><strong>Message:</strong> @ErrorFeature.Error.Message</p>
                <p><strong>Type:</strong> @ErrorFeature.Error.GetType().FullName</p>
                @if (ErrorFeature.Error.InnerException is not null)
                {
                    <p><strong>Inner:</strong> @ErrorFeature.Error.InnerException.Message</p>
                }
                <details class="mt-3">
                    <summary>Stack trace</summary>
                    <pre class="mt-2 text-wrap small bg-light p-3">@ErrorFeature.Error.ToString()</pre>
                </details>
            </div>
        </div>
    }

    <div class="mt-4">
        <h3>What you can do</h3>
        <ul class="mt-2">
            <li>Use the browser back button and retry the last action.</li>
            <li><a href="/">Return to the Verde Energy home page</a>.</li>
            <li>If the problem persists, note the Request ID above and contact Verde Energy support.</li>
        </ul>
    </div>

    @if (!Environment.IsDevelopment())
    {
        <h3 class="mt-4">Development Mode</h3>
        <p>
            Swapping to <strong>Development</strong> environment will display more detailed information about the error that occurred.
        </p>
        <p>
            <strong>The Development environment shouldn't be enabled for deployed applications.</strong>
            It can result in displaying sensitive information from exceptions to end users.
            For local debugging, enable the <strong>Development</strong> environment by setting the <strong>ASPNETCORE_ENVIRONMENT</strong> environment variable to <strong>Development</strong>
            and restarting the app.
        </p>
    }
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);
    private IExceptionHandlerPathFeature? ErrorFeature { get; set; }

    protected override void OnInitialized()
    {
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
        ErrorFeature = HttpContext?.Features.Get<IExceptionHandlerPathFeature>();
        if (ErrorFeature?.Error is not null)
        {
            Logger.LogError(ErrorFeature.Error, "Error page displayed for request {RequestId} on path {Path}", RequestId, ErrorFeature.Path);
        }
        else
        {
            Logger.LogWarning("Error page displayed for request {RequestId} with no exception feature.", RequestId);
        }
    }
}
